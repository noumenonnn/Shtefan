{
  "name": "shtefan",
  "version": "2.0.0",
  "description": "Web site for Shtefant Burger bar-restaurant",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run check && vite build --config vite.config.ts",
    "check": "tsc --noEmit",
    "preview": "vite preview --config vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noumenonnn/Shtefan.git"
  },
  "author": "Vladislav Spiridonov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/noumenonnn/Shtefan/issues"
  },
  "homepage": "https://github.com/noumenonnn/Shtefan#readme",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
